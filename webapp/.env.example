# Base URL of the FastAPI backend (see backend/app/core/config.py, Makefile `backend` target).
# The embedded Engineer's Console iframe (Workspace page) issues its own
# same-origin relative fetches against whatever origin served /console — it
# does not use this variable and is unaffected by CORS regardless of where
# this app itself is hosted. This variable only drives the React app's own
# direct API calls (jobs list/upload, knowledge bases, health).
VITE_API_BASE_URL=http://localhost:8000
