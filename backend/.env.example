# Copy to .env and adjust. All variables are optional for local mock-mode dev.

# Agent backend: "mock" (rule-based, no credentials needed) or "vertex" (Vertex AI)
AGENT_MODE=mock

# GCP settings (required only when AGENT_MODE=vertex)
GCP_PROJECT=
VERTEX_LOCATION=europe-west3
VERTEX_MODEL=gemini-2.5-flash

# Absolute path to the ODA File Converter binary (required only for .dwg uploads;
# .dxf files are processed directly without it)
ODA_CONVERTER_PATH=

# Where uploaded/converted files are staged
WORK_DIR=./workdir
