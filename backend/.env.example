# Copy to .env and adjust. All variables are optional for local mock-mode dev.

# Agent backend: "mock" (rule-based, no credentials needed),
# "openai" (OpenAI API, needs OPENAI_API_KEY), or "vertex" (Vertex AI Gemini)
AGENT_MODE=mock

# GCP settings (required only when AGENT_MODE=vertex)
GCP_PROJECT=
VERTEX_LOCATION=europe-west3
VERTEX_MODEL=gemini-2.5-flash

# --- DWG -> DXF conversion (pick one engine; .dxf files need neither) ---
# LibreDWG dwg2dxf binary (preferred; auto-detected on PATH and ~/.local/bin).
# A from-source build (e.g. a sibling ../libredwg checkout, built via its own
# autogen.sh/configure/make) is generally worth pinning explicitly over
# whatever release happens to be on PATH - upstream fixes real entity-handling
# bugs between releases (confirmed: a build 113 commits past 0.14 fixed
# 3DLINE stability issues a released 0.14 binary didn't have).
# DWG2DXF_PATH=../libredwg/build/dwg2dxf
DWG2DXF_PATH=
# ODA File Converter binary (optional higher-fidelity alternative)
ODA_CONVERTER_PATH=

# --- DXF -> DWG write-back (real .dwg deliverables; see CAD_MANIPULATION_ENGINE.md) ---
# LibreDWG dxf2dwg binary (auto-detected on PATH and ~/.local/bin, like dwg2dxf)
DXF2DWG_PATH=

# --- ACadSharp engine (experimental; see CAD_ENGINE_FRAMEWORK.md) ---
# .NET 8 SDK + tools/acadsharp_cli build output (auto-detected on PATH / ~/.dotnet
# and at tools/acadsharp_cli/bin/Release/net8.0/acadsharp_cli.dll)
DOTNET_PATH=
ACADSHARP_CLI_PATH=

# --- QCAD engine (experimental, DXF-only; see QCAD_CONNECTOR.md) ---
# qcadcmd(.com) headless binary, built from https://github.com/qcad/qcad
# (needs Qt6 + CMake/Ninja - not built by `make setup`, no auto-build target yet)
QCADCMD_PATH=

# --- cad-viewer interactive HTML export (see CAD_VIEWER_INTEGRATION.md) ---
# Node.js 20+ binary and tools/cad_viewer_cli's installed exporter CLI
# (auto-detected on PATH / ~/nodejs/bin and at
# tools/cad_viewer_cli/node_modules/@mlightcad/cad-html-exporter-cli/dist/cli.js)
NODE_PATH=
CAD_VIEWER_CLI_PATH=

# --- Craftsman agent: FreeCAD 2D geometry ops (offset/fillet/join); see
# CRAFTSMAN_AGENT.md ---
# FreeCADCmd (headless) from a FreeCAD build - not vendored in this repo, e.g.
# a sibling checkout of https://github.com/FreeCAD/FreeCAD built via pixi:
# FREECADCMD_PATH=../FreeCAD-pixi/build/debug/bin/FreeCADCmd
FREECADCMD_PATH=

# --- Craftsman "live" mode: real FreeCAD GUI streamed into the browser via
# xpra's HTML5 client, so ops execute live against one persistent document
# instead of a fresh headless subprocess per call. Optional - the live
# button just shows "not configured" if unset. Needs the GUI FreeCAD build
# (not FreeCADCmd) plus xpra, installed without sudo via a project-local
# pixi env: run `backend/tools/freecad_worker/live_env/setup.sh` once, then
# point XPRA_PATH at the printed path. See docs/CRAFTSMAN_AGENT.md.
# FREECAD_GUI_PATH=../FreeCAD-pixi/build/debug/bin/FreeCAD
FREECAD_GUI_PATH=
# XPRA_PATH=backend/tools/freecad_worker/live_env/.pixi/envs/default/bin/xpra
XPRA_PATH=
CRAFTSMAN_LIVE_OP_PORT=8765
CRAFTSMAN_LIVE_HTML_PORT=8766
CRAFTSMAN_LIVE_DISPLAY=:100

# --- OpenAI + Cognee memory (dataset ingestion, summaries, memory chat) ---
# Cognee's default provider is OpenAI and needs only LLM_API_KEY.
# The summarizer uses OPENAI_API_KEY — set both to the same OpenAI key.
LLM_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_SUMMARY_MODEL=gpt-4o-mini

# Cognee guideline memory: seed with `python scripts/seed_memory.py`, then
# agents recall norm snippets into their prompts. Needs LLM_API_KEY.
COGNEE_ENABLED=false

# Optional: point cognee at a hosted Cognee Cloud tenant instead of local
# storage (SQLite/LanceDB/Kuzu). Leave blank to use local storage.
COGNEE_API_BASE_URL=
COGNEE_API_KEY=

# Where uploaded/converted files are staged
WORK_DIR=./workdir

# --- Docling extraction service (dataset/raw -> clean Markdown + images; see
# app/application/documents/). Runs the ML pipeline on a remote server,
# so no local torch/docling install is needed. Extract with:
#   make docling-extract PROJECT=project_1   (or scripts/docling_ingest.py) ---
DOCLING_BASE_URL=http://10.0.1.236/docling
DOCLING_CHUNK_MAX_TOKENS=512
DOCLING_IMAGES_SCALE=2.0
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# --- Refinement layer (dataset/clean -> dataset/super_clean; see
# app/application/documents/refine_pipeline.py). LLM-based OCR/repetition
# cleanup + image description/categorization, same remote server as Docling,
# nginx-proxied at /generative/. Refine with:
#   make docling-refine PROJECT=project_1   (or scripts/docling_refine.py) ---
VLLM_GENERATIVE_BASE_URL=http://10.0.1.236/generative
GENERATIVE_MODEL=google/gemma-4-31B-it

# --- OpenSearch (local vector-search KB evaluation PoC; see
# docs/OPENSEARCH_NEO4J_EVALUATION.md) ---
# docker compose --env-file backend/.env -f docker-compose.kb.yml up -d opensearch opensearch-dashboards
# then: make kb-ingest  (or: .venv/bin/python scripts/kb_ingest_opensearch.py)
OPENSEARCH_ENABLED=false
OPENSEARCH_HOST=http://localhost:9200
OPENSEARCH_INDEX=rail50hz_regulations
# "local" = sentence-transformers all-MiniLM-L6-v2, free/offline (default).
# "openai" = text-embedding-3-small, reuses OPENAI_API_KEY above.
# "vllm" = the remote intfloat/multilingual-e5-large model over the network
# (same one Docling extraction/the org's indexing_service use) - no local
# model weights or API key, just network access to VLLM_EMBEDDINGS_BASE_URL.
OPENSEARCH_EMBEDDING_PROVIDER=local
VLLM_EMBEDDINGS_BASE_URL=http://10.0.1.236/embeddings

# --- Neo4j (local knowledge-graph KB evaluation PoC; see
# docs/OPENSEARCH_NEO4J_EVALUATION.md) ---
# docker compose --env-file backend/.env -f docker-compose.kb.yml up -d neo4j
# then: make kb-ingest  (or: .venv/bin/python scripts/kb_ingest_neo4j.py)
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Must match docker-compose.kb.yml's NEO4J_AUTH password. The compose file's
# own ${NEO4J_PASSWORD:-rail50hz-dev} falls back correctly if left blank, but
# app.core.config.Settings.neo4j_password has no such default (None) - the
# Python client's auth would silently be (neo4j, None) and fail. Set it
# explicitly (e.g. NEO4J_PASSWORD=rail50hz-dev) so both sides agree.
NEO4J_PASSWORD=
